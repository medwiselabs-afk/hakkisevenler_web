# Veritabanı (geliştirme: SQLite dosyası, üretim: PostgreSQL connection string)
DATABASE_URL="file:./dev.db"

# Oturum (JWT) imzalama anahtarı - üretimde `openssl rand -base64 32` ile üretin
AUTH_SECRET="degistir-bunu-uzun-rastgele-bir-deger-ile"

# Sitenin çalıştığı tam adres (iyzico callback URL'i için gerekli)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# iyzico - https://merchant.iyzipay.com üzerinden Sandbox hesabı açıp alın
IYZICO_API_KEY="sandbox-xxxxxxxx"
IYZICO_SECRET_KEY="sandbox-xxxxxxxx"
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
